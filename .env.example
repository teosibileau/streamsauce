# DBOS
DBOS_DATABASE_URL=postgresql://dbos:dbos@0.0.0.0:5432/dbos

# Camera RTSP URLs (add more as CAM2_RTSP_URL, CAM3_RTSP_URL, etc.)
# For input profile (mediamtx): CAM1_RTSP_URL=rtsp://cam:8554/cam1
CAM1_RTSP_URL=rtsp://user:password@192.168.1.100:554/stream1

# MQTT broker
MQTT_HOST=broker
MQTT_PORT=1883
MQTT_TOPIC_PREFIX=streamchop

# Base URL for HLS file access (as seen by MQTT consumers)
HLS_BASE_URL=http://0.0.0.0:8080

# AMQP consumer
AMQP_HOST=broker
AMQP_PORT=5672
AMQP_USERNAME=guest
AMQP_PASSWORD=guest
AMQP_EXCHANGE=amq.topic
AMQP_QUEUE=streamsauce.cv
AMQP_ROUTING_KEYS=streamchop.*.snapshot,streamchop.*.segment
AMQP_PREFETCH=10

# ONNX Detection
ONNX_MODEL_PATH=.data/yolo11n.onnx
ONNX_EXECUTION_PROVIDER=CPUExecutionProvider
ONNX_CONFIDENCE_THRESHOLD=0.25
