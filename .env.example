# DBOS
DBOS_DATABASE_URL=postgresql://dbos:dbos@localhost:5432/dbos
POSTGRES_USER=dbos
POSTGRES_PASSWORD=dbos
POSTGRES_DB=dbos

# Camera RTSP
CAM1_RTSP_URL=rtsp://localhost:8554/cam1

# MQTT broker
MQTT_HOST=broker
MQTT_PORT=1883
MQTT_TOPIC_PREFIX=streamchop

# Base URL for HLS
HLS_BASE_URL=http://localhost:8080

# AMQP consumer
AMQP_HOST=localhost
AMQP_PORT=5672
AMQP_USERNAME=guest
AMQP_PASSWORD=guest
AMQP_EXCHANGE=amq.topic
AMQP_QUEUE=streamsauce.cv
AMQP_ROUTING_KEYS=streamchop.*.snapshot,streamchop.*.segment
AMQP_PREFETCH=10

# ONNX Detection
ONNX_MODEL_PATH=.data/yolo11n.onnx
ONNX_EXECUTION_PROVIDER=CPUExecutionProvider
ONNX_CONFIDENCE_THRESHOLD=0.25
